{
  "urls": {
    "apiBaseUrl": "http://localhost:4000/api/v1",
    "wsPath": "/api/v1/ws",
    "wsOrigin": "http://localhost:4000",
    "qrOrigin": "/api/v1/qr"
  },
  "allowOfflineAdmin": true,
  "theme": {
    "default": "system",
    "force": false
  },
  "smtp": {
    "enabled": true,
    "allowInvalidCert": false,
    "host": "localhost",
    "port": 1025,
    "secure": false,
    "username": "",
    "password": "",
    "fromEmail": "no-reply@example.com",
    "replyTo": "support@example.com",
    "rateLimitPerHour": 500
  },
  "offlineReset": {
    "enabled": true
  },
  "adminDefaults": {
    "username": "admin",
    "password": "changeme"
  },
  "authModes": {
    "oauth": false,
    "simpleSignin": true,
    "domainSignin": false
  },
  "primaryAuthMode": "simple_signin",
  "localization": {
    "locales": ["en-US", "pt-PT", "es-ES"],
    "defaultLocale": "en-US"
  },
  "ui": {
    "pageSize": 20,
    "dateFormat": "YYYY-MM-DD",
    "showDebug": true
  },
  "featureFlags": {
    "newDashboard": true,
    "betaRealtime": true
  },
  "limits": {
    "routes": {
      "dashboard": true,
      "devices": true,
      "numbers": true,
      "users": true,
      "audit": true,
      "logins": true,
      "contacts": true,
      "config": true
    },
    "actions": {
      "numbers": { "create": true, "assign": true, "update": true, "delete": true },
      "devices": { "pair": true, "rename": true, "toggle": true },
      "users": { "editRoles": true, "forceLogout": true },
      "contacts": { "sync": true, "export": true },
      "audit": { "export": true }
    },
    "realtime": { "enabled": true, "statusBar": true },
    "debug": { "ui": true, "logs": true }
  },
  "realtime": {
    "pingMs": 12000,
    "reconnectCapMs": 20000
  },
  "contacts": {
    "syncIntervalMinutes": 20,
    "conflictStrategy": "prompt"
  },
  "logging": {
    "level": "debug",
    "console": true
  },
  "telemetry": {
    "enabled": false,
    "sampleRate": 1,
    "endpoint": ""
  }
}
