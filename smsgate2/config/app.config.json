{
  "urls": {
    "apiBaseUrl": "https://api.example.com/api/v1",
    "wsPath": "/api/v1/ws",
    "wsOrigin": "https://api.example.com",
    "qrOrigin": "/api/v1/qr"
  },
  "allowOfflineAdmin": false,
  "theme": {
    "default": "system",
    "force": false
  },
  "smtp": {
    "enabled": true,
    "allowInvalidCert": false,
    "host": "smtp.example.com",
    "port": 587,
    "secure": false,
    "username": "smtp-user",
    "password": "smtp-pass",
    "fromEmail": "no-reply@example.com"
  },
  "offlineReset": {
    "enabled": true
  },
  "adminDefaults": {
    "username": "admin",
    "password": "changeme"
  },
  "authModes": {
    "oauth": true,
    "simpleSignin": true,
    "domainSignin": false
  },
  "primaryAuthMode": "simple_signin",
  "localization": {
    "locales": ["en-US", "pt-PT", "es-ES"],
    "defaultLocale": "en-US"
  }
}
