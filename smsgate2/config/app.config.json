{
  "urls": {
    "apiBaseUrl": "https://api.example.com/api/v1",
    "wsPath": "/api/v1/ws",
    "wsOrigin": "https://api.example.com",
    "qrOrigin": "/api/v1/qr"
  },
  "allowOfflineAdmin": false,
  "theme": {
    "default": "system",
    "force": false
  },
  "smtp": {
    "enabled": true,
    "allowInvalidCert": false,
    "host": "smtp.example.com",
    "port": 587,
    "secure": false,
    "username": "smtp-user",
    "password": "smtp-pass",
    "fromEmail": "no-reply@example.com",
    "replyTo": "support@example.com",
    "rateLimitPerHour": 200
  },
  "offlineReset": {
    "enabled": true
  },
  "adminDefaults": {
    "username": "admin",
    "password": "changeme"
  },
  "authModes": {
    "oauth": true,
    "simpleSignin": true,
    "domainSignin": false
  },
  "primaryAuthMode": "simple_signin",
  "localization": {
    "locales": ["en-US", "pt-PT", "es-ES"],
    "defaultLocale": "en-US"
  },
  "ui": {
    "pageSize": 20,
    "dateFormat": "YYYY-MM-DD",
    "showDebug": false
  },
  "featureFlags": {
    "newDashboard": false,
    "betaRealtime": false
  },
  "realtime": {
    "pingMs": 15000,
    "reconnectCapMs": 30000
  },
  "contacts": {
    "syncIntervalMinutes": 30,
    "conflictStrategy": "prompt"
  },
  "logging": {
    "level": "info",
    "console": true
  },
  "telemetry": {
    "enabled": false,
    "sampleRate": 1,
    "endpoint": ""
  }
}
