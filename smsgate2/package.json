{
  "name": "smsgate2",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.1.30",
  "scripts": {
    "dev": "bun --bun next dev",
    "dev:turbo": "bun --bun next dev --turbo",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "bun --bun eslint . --ext .ts,.tsx --max-warnings=0",
    "typecheck": "bun --bun tsc --noEmit",
    "test": "vitest run --pool=forks",
    "test:watch": "vitest watch --pool=forks",
    "test:e2e": "playwright test",
    "test:i18n": "vitest run tests/i18n.test.ts",
    "scan:i18n": "node scripts/find-i18n-hardcoded.js",
    "format": "bun --bun prettier --check .",
    "format:write": "bun --bun prettier --write .",
    "package": "docker build -f Dockerfile -t smsgate2:ci ."
  },
  "dependencies": {
    "bulma": "^0.9.4",
    "next": "^16.0.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.57.0",
    "@types/node": "^20.12.12",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.70",
    "@types/react-dom": "^18.2.23",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "eslint": "^9.13.0",
    "eslint-config-next": "^16.0.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^16.5.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^1.6.0"
  }
}
