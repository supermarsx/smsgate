{
  "env": "development",
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "ws_max_connections": 5000,
    "ws_snapshot_limit": 10,
    "ws_ping_interval_ms": 15000
  },
  "ingest": {
    "dedup_ttl_ms": 60000,
    "hot_store_capacity": 1000,
    "max_batch": 100
  },
  "presence": {
    "online_threshold_ms": 20000,
    "degraded_threshold_ms": 60000
  },
  "pairing": {
    "session_ttl_secs": 600,
    "bootstrap_device": null
  },
  "seeding": {
    "users": [],
    "numbers": [],
    "devices": []
  },
  "hot_store": {
    "mode": "memory",
    "redis_url": null
  },
  "database": {
    "adapter": "json_db",
    "path": "data/syncserver.json",
    "url": null
  },
  "rbac": {
    "roles": [
      {
        "name": "admin",
        "precedence": 100,
        "permissions": [
          "events.read",
          "events.claim",
          "events.verify",
          "events.reject",
          "devices.read",
          "devices.write",
          "devices.disable",
          "devices.rotate_token",
          "numbers.read",
          "numbers.write",
          "users.read",
          "users.write",
          "users.force_logout",
          "users.unlock",
          "config.read",
          "config.write",
          "audit.read",
          "logins.read"
        ]
      },
      {
        "name": "manager",
        "precedence": 50,
        "permissions": [
          "events.read",
          "events.claim",
          "events.verify",
          "devices.read",
          "numbers.read",
          "users.read",
          "audit.read",
          "logins.read"
        ]
      }
    ],
    "group_mapping": {}
  },
  "auth": {
    "modes": ["simple_signin"],
    "password_pepper": null,
    "password_min_length": 12,
    "admin_password_min_length": 16,
    "password_min_entropy_bits": 48,
    "password_history_size": 5,
    "weak_passwords": ["password", "123456", "123456789", "qwerty", "letmein"],
    "max_failed_attempts": 5,
    "lockout_secs": 300,
    "bootstrap_admin_username": "admin",
    "smtp": null,
    "session_ttl_secs": 86400,
    "require_admin_totp": true,
    "oauth_issuer": null,
    "oauth_audience": null,
    "oauth_hmac_secret": null,
    "domain_shared_secret": null
  }
}
