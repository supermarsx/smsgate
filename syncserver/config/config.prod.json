{
  "env": "production",
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "ws_max_connections": 5000,
    "ws_snapshot_limit": 10,
    "ws_ping_interval_ms": 15000
  },
  "ingest": {
    "dedup_ttl_ms": 60000,
    "hot_store_capacity": 50000,
    "max_batch": 500,
    "persist_new": true,
    "persist_states": ["verified", "rejected", "claimed"]
  },
  "presence": {
    "online_threshold_ms": 20000,
    "degraded_threshold_ms": 60000
  },
  "pairing": {
    "session_ttl_secs": 600,
    "bootstrap_device": null
  },
  "seeding": {
    "users": [],
    "numbers": [],
    "devices": []
  },
  "hot_store": {
    "mode": "redis",
    "redis_url": "redis://redis:6379/0"
  },
  "database": {
    "adapter": "postgres",
    "url": "postgres://syncserver:password@db:5432/syncserver",
    "path": null,
    "enable_audit_log": true
  },
  "rbac": {
    "roles": [
      {
        "name": "admin",
        "precedence": 100,
        "permissions": [
          "events.read",
          "events.claim",
          "events.verify",
          "events.reject",
          "devices.read",
          "devices.write",
          "devices.disable",
          "devices.rotate_token",
          "numbers.read",
          "numbers.write",
          "users.read",
          "users.write",
          "users.force_logout",
          "users.unlock",
          "config.read",
          "config.write",
          "audit.read",
          "logins.read"
        ]
      },
      {
        "name": "manager",
        "precedence": 50,
        "permissions": [
          "events.read",
          "events.claim",
          "events.verify",
          "devices.read",
          "numbers.read",
          "users.read",
          "audit.read",
          "logins.read"
        ]
      },
      {
        "name": "auditor",
        "precedence": 10,
        "permissions": ["audit.read", "logins.read", "events.read"]
      }
    ],
    "group_mapping": {}
  },
  "auth": {
    "modes": ["simple_signin", "oauth", "domain_signin"],
    "password_pepper": null,
    "password_min_length": 14,
    "admin_password_min_length": 18,
    "password_min_entropy_bits": 80,
    "password_history_size": 5,
    "weak_passwords": ["password", "123456", "123456789", "qwerty", "letmein", "admin", "changeme", "welcome"],
    "max_failed_attempts": 5,
    "lockout_secs": 900,
    "bootstrap_admin_username": "sync-prod-admin",
    "smtp": {
      "server": "smtp.example.com",
      "port": 587,
      "username": "smtp-user",
      "password": "smtp-password",
      "from": "no-reply@example.com",
      "use_tls": true
    },
    "session_ttl_secs": 86400,
    "require_admin_totp": true,
    "oauth_issuer": "https://issuer.example.com/",
    "oauth_audience": "syncserver-prod",
    "oauth_hmac_secret": "replace-with-strong-secret",
    "domain_shared_secret": "replace-with-domain-secret"
  }
}
